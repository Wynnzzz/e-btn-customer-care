{
    "rewrites": [
      {
        "source": "/img/:path*",
        "destination": "/img/:path*"
      },
      {
        "source": "/vid/:path*",
        "destination": "/vid/:path*"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "public": true
  }